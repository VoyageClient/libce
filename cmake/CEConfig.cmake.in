get_filename_component(libce_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH ${libce_CMAKE_DIR})
list(REMOVE_AT CMAKE_MODULE_PATH -1)

if(NOT TARGET libce::libce)
  include("${libce_CMAKE_DIR}/libceTargets.cmake")
endif()

set(libce_LIBRARIES libce::libce)
